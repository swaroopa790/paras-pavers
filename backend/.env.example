# --- Database ---
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=paras_pavers
DB_SSL=true

# --- AI (optional — calculator works fine without it) ---
AI_API_KEY=

# --- Admin panel ---
# Set this to a long random string. Send it as: Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=change-me-to-a-long-random-secret

# --- CORS ---
# Comma-separated list of allowed origins, or * for any (fine for a single-service deploy)
CORS_ORIGIN=*

# --- Server ---
PORT=3000
